rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/artifacts/yunas-shop-crm/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/artifacts/yunas-shop-crm/admins/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/artifacts/yunas-shop-crm/admins/$(request.auth.uid)).data.active == true;
    }

    match /artifacts/yunas-shop-crm/admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /artifacts/yunas-shop-crm/public/data/linkRequests/{requestId} {
      allow create: if request.auth == null &&
        request.resource.data.reference is string &&
        request.resource.data.reference.size() >= 10 &&
        request.resource.data.reference.size() <= 24 &&
        (
          (
            request.resource.data.keys().hasOnly([
              'reference',
              'links',
              'whatsapp',
              'locale',
              'status',
              'createdAt',
              'updatedAt'
            ]) &&
            request.resource.data.links is list &&
            request.resource.data.links.size() >= 1 &&
            request.resource.data.links.size() <= 30 &&
            request.resource.data.whatsapp is string &&
            request.resource.data.whatsapp.size() >= 11 &&
            request.resource.data.whatsapp.size() <= 15
          ) ||
          (
            request.resource.data.keys().hasOnly([
              'reference',
              'requestItems',
              'links',
              'responseChannel',
              'responseContact',
              'whatsapp',
              'locale',
              'status',
              'createdAt',
              'updatedAt'
            ]) &&
            request.resource.data.requestItems is list &&
            request.resource.data.requestItems.size() >= 1 &&
            request.resource.data.requestItems.size() <= 30 &&
            request.resource.data.links is list &&
            request.resource.data.links.size() <= 30 &&
            request.resource.data.responseChannel in ['instagram', 'messenger', 'whatsapp'] &&
            request.resource.data.responseContact is string &&
            request.resource.data.responseContact.size() >= 1 &&
            request.resource.data.responseContact.size() <= 150 &&
            request.resource.data.whatsapp is string &&
            request.resource.data.whatsapp.size() <= 15 &&
            (
              (
                request.resource.data.responseChannel == 'whatsapp' &&
                request.resource.data.responseContact.matches('^213[567][0-9]{8}$') &&
                request.resource.data.whatsapp == request.resource.data.responseContact
              ) ||
              (
                request.resource.data.responseChannel != 'whatsapp' &&
                request.resource.data.whatsapp == ''
              )
            )
          )
        ) &&
        request.resource.data.locale in ['fr', 'ar'] &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    match /artifacts/yunas-shop-crm/public/data/{collection}/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
